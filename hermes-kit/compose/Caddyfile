# The box's only door. Caddy issues and renews the certificates on its own.
#
# Two hostnames on the same IP because the portal needs TWO separate bases
# (endpoint and adapter), and mounting services under a path prefix is asking
# Hermes for something it never promised. Two A records to the same IP and
# that's it.
{
	email {$EMAIL_TLS}
}

# ── The Hermes gateway: chat, sessions, jobs ──────────────────────────────
{$API_DOMAIN} {
	reverse_proxy hermes:8642 {
		# THE CHAT IS SSE. If the proxy buffers bytes, the client sees the
		# whole response at once at the end, or doesn't see it at all. -1 =
		# send every write as soon as it happens.
		# Caddy detects this on its own when Content-Type is
		# text/event-stream, but it's explicit here anyway: we've already
		# eaten two streaming bugs in the portal and it's not worth relying
		# on a heuristic.
		flush_interval -1

		# A long job can take a while. Without this, the proxy cuts off at
		# 30 s and the client sees an error where the agent was actually
		# still working.
		transport http {
			read_timeout 30m
			write_timeout 30m
		}
	}

	# CORS is handled by Hermes with API_SERVER_CORS_ORIGINS. If we added it
	# here too, the browser gets the header TWICE and rejects everything —
	# which reads exactly like "the server is down."

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	log {
		output file /data/access-api.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}

# ── The adapter: tickets, approvals, deliverables, files, connections ─────
{$PORTAL_DOMAIN} {
	reverse_proxy portal-adapter:8643 {
		flush_interval -1
		transport http {
			read_timeout 30m
			write_timeout 30m
		}
	}

	# The client uploads files through here.
	request_body {
		max_size 100MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	log {
		output file /data/access-portal.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
