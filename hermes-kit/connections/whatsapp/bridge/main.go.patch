+
+// ── PARCHE tuagente: pareo a demanda ────────────────────────────────────────
+//
+// Tres endpoints para que el portal pueda hacer el pareo con sus propios pasos,
+// sin que nadie mire un log ni entre a una terminal:
+//
+//   POST /pair/start   arranca el pedido de QR (solo si no hay sesion)
+//   GET  /pair/status  {paired, pairing, has_qr}
+//   GET  /pair/qr.png  el QR, que se renueva sobre el mismo archivo
+//
+// Nada de esto habla con el modelo: es plomeria del portal. Las herramientas
+// del agente siguen pasando por la guardia.
+
+var pareando bool
+var pareoMu sync.Mutex
+
+func registrarPareo(client *whatsmeow.Client, logger waLog.Logger) {
+	http.HandleFunc("/pair/status", func(w http.ResponseWriter, r *http.Request) {
+		pareoMu.Lock()
+		enCurso := pareando
+		pareoMu.Unlock()
+		_, err := os.Stat("store/qr.png")
+		w.Header().Set("Content-Type", "application/json")
+		json.NewEncoder(w).Encode(map[string]bool{
+			"paired":  client.Store.ID != nil,
+			"pairing": enCurso,
+			"has_qr":  err == nil,
+		})
+	})
+
+	http.HandleFunc("/pair/qr.png", func(w http.ResponseWriter, r *http.Request) {
+		datos, err := os.ReadFile("store/qr.png")
+		if err != nil {
+			http.Error(w, "todavia no hay QR", http.StatusNotFound)
+			return
+		}
+		w.Header().Set("Content-Type", "image/png")
+		w.Header().Set("Cache-Control", "no-store")   // se renueva cada segundos
+		w.Write(datos)
+	})
+
+	http.HandleFunc("/pair/start", func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost {
+			http.Error(w, "usa POST", http.StatusMethodNotAllowed)
+			return
+		}
+		if client.Store.ID != nil {
+			w.Header().Set("Content-Type", "application/json")
+			json.NewEncoder(w).Encode(map[string]any{"ok": true, "paired": true})
+			return
+		}
+		pareoMu.Lock()
+		if pareando {
+			pareoMu.Unlock()
+			w.Header().Set("Content-Type", "application/json")
+			json.NewEncoder(w).Encode(map[string]any{"ok": true, "pairing": true})
+			return
+		}
+		pareando = true
+		pareoMu.Unlock()
+
+		go func() {
+			defer func() { pareoMu.Lock(); pareando = false; pareoMu.Unlock() }()
+			qrChan, _ := client.GetQRChannel(context.Background())
+			if err := client.Connect(); err != nil {
+				logger.Errorf("pareo: no pude conectar: %v", err)
+				return
+			}
+			for evt := range qrChan {
+				switch evt.Event {
+				case "code":
+					if err := qrcode.WriteFile(evt.Code, qrcode.Medium, 512, "store/qr.png"); err != nil {
+						logger.Warnf("pareo: no pude escribir el QR: %v", err)
+					}
+				case "success":
+					os.Remove("store/qr.png")
+					logger.Infof("pareo: listo, sesion establecida")
+					return
+				case "timeout":
+					os.Remove("store/qr.png")
+					logger.Warnf("pareo: se vencio sin que nadie lo escaneara")
+					return
+				}
+			}
+		}()
+
+		w.Header().Set("Content-Type", "application/json")
+		json.NewEncoder(w).Encode(map[string]any{"ok": true, "pairing": true})
+	})
+}
