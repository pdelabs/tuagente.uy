# Bridge de whatsapp-mcp. Se compila acá y no en el contenedor del cliente:
# bajar y compilar en vivo adentro del agente es justo lo que el roadmap marca
# como riesgoso.
FROM golang:1.25-bookworm AS build
WORKDIR /src
COPY whatsapp-bridge/go.mod whatsapp-bridge/go.sum ./
RUN go mod download
COPY whatsapp-bridge/ ./
# CGO prendido: go-sqlite3 lo necesita.
RUN CGO_ENABLED=1 go build -o /bridge .

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /bridge /app/bridge
# El QR y la sesión viven en /app/store, que es el volumen del cliente.
EXPOSE 8080
CMD ["/app/bridge"]
