INSTANCE=tuagente
PORT_GATEWAY=8652
PORT_ADAPTER=8653
# What this agent runs, in load order: the system set plus what it uses —
# pictures and posts, Instagram's comments and messages, and the inbox.
CORE_PLUGINS=kanban,approval,memory,image,instagram,social,mail,notify,business
# The lab's Phoenix, published on the host's loopback by docker-compose.yml.
CORE_OTEL_ENDPOINT=http://host.docker.internal:6006/v1/traces
CORE_OTEL_INCLUDE_CONTENT=1
