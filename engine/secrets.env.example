# Copy to secrets.env (gitignored) and fill in.
# The bearer the portal sends on every request; it travels in the magic link.
API_SERVER_KEY=
# The model key. The engine talks to OpenRouter and to nothing else.
OPENROUTER_API_KEY=

# PUBLISHING TO INSTAGRAM, all of it optional: without these the agent still
# writes the post and still asks for permission to publish it, and answers
# «Falta conectar Instagram: no está <la que falte>» once the client says yes.
# What each one is, and why a bucket is in the list at all:
# `engine/README.md`, «Publishing».
#
# The Instagram API with Instagram Login: a professional account, a long-lived
# user token — IT EXPIRES IN 60 DAYS, silently — and the account's id.
IG_ACCESS_TOKEN=
IG_USER_ID=
# Cloudflare R2. Instagram fetches the pictures itself and only takes PUBLIC
# urls, and this engine serves every byte behind the bearer: the slides go up
# here for the length of one publish and are deleted on the way out.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# TELLING THE OWNER, by mail (`kit/plugins/notify/`). Without the key there is
# no channel and the portal offers none — not an error. ONE key for the whole
# fleet: the mail goes out from our domain as "<agent name> <NOTIFY_FROM>".
RESEND_API_KEY=
NOTIFY_FROM=avisos@tuagente.uy
# Where the links in the mail open. Never with a hash.
PORTAL_URL=http://localhost:8090
# At most one mail per this many seconds, and the reminder for a request still
# waiting after this many.
NOTIFY_EVERY=1800
NOTIFY_REMIND_AFTER=10800
