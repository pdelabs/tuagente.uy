+// ── tuagente PATCH: pairing on demand ────────────────────────────────
+//
+// Three endpoints so the portal can drive pairing through its own steps,
+// with nobody watching a log or opening a terminal:
+//
+//   POST /pair/start   starts the QR request (only if there is no session)
+//   GET  /pair/status  {paired, pairing, has_qr}
+//   GET  /pair/qr.png  the QR, refreshed over the same file
+//
+// None of this talks to the model: it is portal plumbing. The agent's
+// tools still go through the guard.
+
+var pairing bool
+var pairingMu sync.Mutex
+
+func registerPairing(client *whatsmeow.Client, logger waLog.Logger) {
+	http.HandleFunc("/pair/status", func(w http.ResponseWriter, r *http.Request) {
+		pairingMu.Lock()
+		inProgress := pairing
+		pairingMu.Unlock()
+		_, err := os.Stat("store/qr.png")
+		w.Header().Set("Content-Type", "application/json")
+		json.NewEncoder(w).Encode(map[string]bool{
+			"paired":  client.Store.ID != nil,
+			"pairing": inProgress,
+			"has_qr":  err == nil,
+		})
+	})
+
+	http.HandleFunc("/pair/qr.png", func(w http.ResponseWriter, r *http.Request) {
+		qrBytes, err := os.ReadFile("store/qr.png")
+		if err != nil {
+			http.Error(w, "no QR yet", http.StatusNotFound)
+			return
+		}
+		w.Header().Set("Content-Type", "image/png")
+		w.Header().Set("Cache-Control", "no-store")   // refreshed every few seconds
+		w.Write(qrBytes)
+	})
+
+	http.HandleFunc("/pair/start", func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost {
+			http.Error(w, "use POST", http.StatusMethodNotAllowed)
+			return
+		}
+		if client.Store.ID != nil {
+			w.Header().Set("Content-Type", "application/json")
+			json.NewEncoder(w).Encode(map[string]any{"ok": true, "paired": true})
+			return
+		}
+		pairingMu.Lock()
+		if pairing {
+			pairingMu.Unlock()
+			w.Header().Set("Content-Type", "application/json")
+			json.NewEncoder(w).Encode(map[string]any{"ok": true, "pairing": true})
+			return
+		}
+		pairing = true
+		pairingMu.Unlock()
+
+		go func() {
+			defer func() { pairingMu.Lock(); pairing = false; pairingMu.Unlock() }()
+			qrChan, _ := client.GetQRChannel(context.Background())
+			if err := client.Connect(); err != nil {
+				logger.Errorf("pairing: could not connect: %v", err)
+				return
+			}
+			for evt := range qrChan {
+				switch evt.Event {
+				case "code":
+					if err := qrcode.WriteFile(evt.Code, qrcode.Medium, 512, "store/qr.png"); err != nil {
+						logger.Warnf("pairing: could not write the QR: %v", err)
+					}
+				case "success":
+					os.Remove("store/qr.png")
+					logger.Infof("pairing: done, session established")
+					return
+				case "timeout":
+					os.Remove("store/qr.png")
+					logger.Warnf("pairing: expired with nobody scanning it")
+					return
+				}
+			}
+		}()
+
+		w.Header().Set("Content-Type", "application/json")
+		json.NewEncoder(w).Encode(map[string]any{"ok": true, "pairing": true})
+	})
+}
