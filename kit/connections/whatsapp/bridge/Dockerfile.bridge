# whatsapp-mcp bridge. Built here, not inside the client's container:
# pulling and building live inside the agent is exactly what the roadmap
# flags as risky.
FROM golang:1.25-bookworm AS build
WORKDIR /src
COPY whatsapp-bridge/go.mod whatsapp-bridge/go.sum ./
RUN go mod download
COPY whatsapp-bridge/ ./
# CGO on: go-sqlite3 needs it.
RUN CGO_ENABLED=1 go build -o /bridge .

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /bridge /app/bridge
# The QR and the session live in /app/store, the client's volume.
EXPOSE 8080
CMD ["/app/bridge"]
